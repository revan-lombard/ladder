# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is public by design — Row Level Security is the boundary.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Web push (public half of the VAPID pair — generate with node tools/generate-vapid.mjs).
VITE_VAPID_PUBLIC_KEY=
